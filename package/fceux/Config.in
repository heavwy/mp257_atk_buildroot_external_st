config BR2_PACKAGE_FCEUX
	bool "fceux"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_PACKAGE_SDL2
	depends on BR2_PACKAGE_ZLIB
	depends on BR2_PACKAGE_LIBPNG
	depends on BR2_PACKAGE_LIBARCHIVE
	depends on BR2_PACKAGE_LUA
	help
	  FCEUX is a cross-platform, multi-purpose NES/Famicom emulator.
	  Designed for STM32MP257 MIPI display via KMS/DRM.

	  http://fceux.com
